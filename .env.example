# ============================================================
# DELINEASI DTA BBWS SERAYU OPAK
# Source dataset: LOCAL filesystem
# Production runtime: Cloudflare R2
# Copy to .env for local migration/testing. NEVER commit real credentials.
# ============================================================

NOMINATIM_USER_AGENT=bbwsso-delineasi-dta/1.0

# Dataset aktif
HYDRO_DATASET=1km2

# local = baca langsung folder data/ di komputer
# r2    = production, baca bundle dari Cloudflare R2
DATA_BACKEND=r2

# ------------------------------------------------------------
# Sumber data lokal untuk pembuatan bundle R2
# Kosong = otomatis memakai <repo>/data
# Boleh menunjuk langsung ke folder .../data dari lokasi lain.
# ------------------------------------------------------------
LOCAL_DATA_DIR=

# ------------------------------------------------------------
# Cloudflare R2
# ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional; kosong = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# Private runtime bucket
R2_RUNTIME_BUCKET=dta-runtime
R2_MANIFEST_KEY=manifest.json

# Public map-assets bucket, dipakai saat upload dari komputer lokal
R2_MAP_ASSETS_BUCKET=dta-map-assets
# Custom domain public map assets, tanpa trailing slash
# Example: https://data-dta.example.go.id
R2_MAP_ASSETS_PUBLIC_BASE=

# Runtime cache Vercel (/tmp jika kosong)
R2_REFRESH_CACHE=0
DTA_RUNTIME_CACHE_DIR=
# Parallel download hanya membantu cold start network I/O; default aman untuk Hobby.
R2_DOWNLOAD_WORKERS=4
# 0 = percaya ukuran + SHA manifest; 1 = hitung ulang SHA setelah setiap download.
R2_VERIFY_DOWNLOAD_SHA256=0
# Konversi raster bundle menjadi COG kategorikal; fallback otomatis ke DEFLATE.
R2_RASTER_COG_COMPRESSION=ZSTD

# ------------------------------------------------------------
# Vercel Hobby performance guard
# ------------------------------------------------------------
# GIS/Shapely/Rasterio bersifat CPU-heavy. Pertahankan 1 pada worker 1 vCPU.
DTA_MAX_CONCURRENT_HEAVY_JOBS=1
DTA_MAX_QUEUED_HEAVY_JOBS=4
DTA_HEAVY_JOB_QUEUE_TIMEOUT_S=25

# Cache topology ringan dan cache geometry berat dipisahkan.
DTA_TOPOLOGY_CACHE_SIZE=2048
DTA_UPSTREAM_UNION_CACHE_SIZE=24
DTA_HYBRID_CACHE_SIZE=16
DTA_BOUNDARY_CACHE_SIZE=16
# Cache geometry dibersihkan saat RSS mendekati batas memory worker.
DTA_CACHE_PRESSURE_MB=1400
DTA_REQUEST_REGISTRY_MAX_CLIENTS=2048

# Optional basemap tile endpoints
GOOGLE_MAPS_TILE_URL=
GOOGLE_SATELLITE_TILE_URL=
